{
  "name": "screenshot-to-code",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "pnpm run test:frontend && pnpm run test:backend",
    "test:frontend": "pnpm -C frontend test",
    "test:backend": "cd backend && poetry run pytest",
    "up": "docker-compose up -d --build",
    "down": "docker-compose down",
    "restart": "docker-compose restart",
    "rebuild": "docker-compose up -d --build",
    "logs": "docker-compose logs -f",
    "logs:backend": "docker logs -f screenshot-to-code-backend-1 --tail 50",
    "logs:frontend": "docker logs -f screenshot-to-code-frontend-1 --tail 50",
    "ps": "docker-compose ps"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "packageManager": "pnpm@10.32.1"
}
